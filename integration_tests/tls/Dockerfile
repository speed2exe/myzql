# MySQL server with the test certificates baked in, used by the TLS integration
# tests. The certificates are generated by `docker-test.sh` into the build
# context and are not part of the repository.
FROM mysql:8.0
COPY ca.pem server-cert.pem server-key.pem wronghost-cert.pem wronghost-key.pem /etc/mysql/test-certs/
RUN chown -R mysql:mysql /etc/mysql/test-certs \
 && chmod 600 /etc/mysql/test-certs/*-key.pem \
 && chmod 644 /etc/mysql/test-certs/*-cert.pem /etc/mysql/test-certs/ca.pem
